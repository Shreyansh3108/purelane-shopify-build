{% comment %}
  snippets/price.liquid
  Renders product price, compare-at price, and computed discount percentage
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign target = current_variant | default: product
  assign compare_at_price = target.compare_at_price
  assign price = target.price

  assign has_discount = false
  if compare_at_price > price
    assign has_discount = true
    assign discount_percent = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
  endif
-%}

<div class="product-card__price-row">
  <strong class="product-card__price">{{ price | money_without_trailing_zeros }}</strong>
  {%- if has_discount -%}
    <s class="product-card__compare-price">{{ compare_at_price | money_without_trailing_zeros }}</s>
    <em class="product-card__discount-badge">{{ discount_percent }}{{ 'purelane.product.percent_off' | t }}</em>
  {%- endif -%}
</div>