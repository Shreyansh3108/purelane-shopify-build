{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_sold_out = true
  if current_variant.available
    assign is_sold_out = false
  endif

  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  assign badge_text = product.metafields.custom.badge.value | default: card_badge
%}

<article class="glass card rv">
  <div class="shot">
    {% if is_sold_out %}
      <span class="pill pill-sold-out" style="color: var(--paper-2); border-color: var(--paper-2);">Sold out</span>
    {% elsif badge_text != blank %}
      <span class="pill">{{ badge_text | escape }}</span>
    {% endif %}

    <a href="{{ product.url }}" class="shot-link" aria-label="{{ product.title | escape }}" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 400 | image_tag: class: 'pimg', loading: 'lazy', alt: product.title, style: 'height: 122px; width: auto; object-fit: contain; filter: drop-shadow(0 12px 18px rgba(1,24,22,.5));' }}
      {% else %}
        <div class="pimg-placeholder" aria-hidden="true" style="height: 150px; display: flex; align-items: center; color: var(--paper-3); font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">
          <span>No image</span>
        </div>
      {% endif %}
    </a>
  </div>

  <h4 class="card-title" title="{{ product.title | escape }}" style="font-family: 'Outfit', sans-serif; font-size: 13.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; line-height: 1.2; margin-bottom: 7px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
    <a href="{{ product.url }}" style="text-decoration: none; color: var(--surface);">{{ product.title | escape }}</a>
  </h4>

  <div class="rate" style="font-size: 11.5px; color: var(--paper-2); margin-bottom: 10px; display: flex; align-items: center; gap: 5px;">
    <b style="color: var(--accent); font-weight: 700;">★ {{ product.metafields.reviews.rating.value | default: '4.8' }}</b> 
    · {{ product.metafields.reviews.rating_count | default: '237' }} reviews
  </div>

  <div class="pr" style="margin-top: auto; display: flex; align-items: baseline; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
    <strong style="font-family: 'Outfit', sans-serif; font-size: 18px; color: var(--surface); font-weight: 700;">{{ current_variant.price | money_without_trailing_zeros }}</strong>
    {% if has_discount %}
      <s style="font-size: 12px; color: var(--paper-3);">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
      <em style="font-style: normal; font-size: 10px; font-weight: 800; letter-spacing: .08em; color: var(--accent); white-space: nowrap;">{{ discount_percent }}% off</em>
    {% endif %}
  </div>

  {% form 'product', product, id: nil, class: 'card-form', style: 'width: 100%;' %}
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    <button type="submit" class="btn btn-ghost btn-sm" style="width:100%; justify-content:center;" {% if is_sold_out %}disabled aria-disabled="true"{% endif %}>
      {% if is_sold_out %}Out of Stock{% else %}Add to cart{% endif %}
    </button>
  {% endform %}
</article>