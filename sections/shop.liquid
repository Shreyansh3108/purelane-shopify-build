{% comment %}
  sections/shop.liquid
  renders: Shop grid section
  depends on: snippets/product-card.liquid
{% endcomment %}

{{ 'section-shop.css' | asset_url | stylesheet_tag }}

<section class="section-shop" data-section-id="{{ section.id }}">
  <div class="section-shop__inner">
    <header class="section-shop__header rv">
      <span class="section-shop__kicker kicker">{{ section.settings.kicker_text }}</span>
      <h2 class="section-shop__heading d2">
        {{ section.settings.heading }}
        <span class="lime">{{ section.settings.stat_number }}</span>
        {{ section.settings.heading_suffix }}
      </h2>
    </header>

    <div class="section-shop__grid">
      {%- if section.settings.product_source == 'manual' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank -%}
            <div class="section-shop__item rv" style="transition-delay: {{ forloop.index0 | times: 0.1 }}s;" {{ block.shopify_attributes }}>
              {% render 'product-card', product: block.settings.product %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif section.settings.product_source == 'collection' and section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.product_limit -%}
          <div class="section-shop__item rv" style="transition-delay: {{ forloop.index0 | times: 0.1 }}s;">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section-shop",
  "settings": [
    { "type": "text", "id": "kicker_text", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by" },
    { "type": "text", "id": "stat_number", "label": "Stat number", "default": "30,000" },
    { "type": "text", "id": "heading_suffix", "label": "Heading suffix", "default": "homes" },
    { "type": "select", "id": "product_source", "label": "Product source", "options": [
      { "value": "manual", "label": "Manual list" },
      { "value": "collection", "label": "Collection" }
    ], "default": "manual" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used if source is set to Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [ { "type": "product", "id": "product", "label": "Product" } ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Shop grid" }]
}
{% endschema %}